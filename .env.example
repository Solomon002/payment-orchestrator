# Copy to .env (`pnpm run setup` does this for you and fills every __GENERATE__
# value with a fresh random secret). Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# ---- API ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_ORIGIN=http://localhost:5173
# Dashboard login key. Long random string; compared in constant time.
ADMIN_API_KEY=__GENERATE__

# ---- Infrastructure (docker-compose.yml) ----
DATABASE_URL=postgresql://po:po_dev_password@localhost:5433/payments?schema=public&connection_limit=20
DATABASE_URL_TEST=postgresql://po:po_dev_password@localhost:5433/payments_test?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6380/0
REDIS_URL_TEST=redis://localhost:6380/1

# ---- Demo merchant (created by the seed script) ----
# In a real system merchant keys are shown once and never stored in plaintext.
# It lives here only so the local demo is easy to drive.
DEMO_MERCHANT_API_KEY=__GENERATE_SK__

# ---- Mock gateways (apps/mock-gateway) ----
MOCKPAY_A_URL=http://localhost:4101
MOCKPAY_A_SECRET=__GENERATE__
MOCKPAY_B_URL=http://localhost:4102
MOCKPAY_B_SECRET=__GENERATE__
# Key the API uses to change mock-gateway behaviour (simulator page).
MOCK_CONTROL_KEY=__GENERATE__

# ---- Paystack (optional, TEST MODE ONLY) ----
# Leave empty to run with mock gateways only. Live keys (sk_live_) are rejected at startup.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# ---- Fees ----
# Platform fee charged to the merchant, in basis points (150 = 1.5%), capped.
PLATFORM_FEE_BPS=150
PLATFORM_FEE_CAP_KOBO=200000

# ---- Routing / circuit breaker ----
ROUTING_WINDOW_SIZE=20
ROUTING_MIN_SAMPLES=5
ROUTING_MIN_SUCCESS_RATE=0.8
ROUTING_COOLDOWN_MS=30000
ROUTING_PROBE_SUCCESSES=3
GATEWAY_TIMEOUT_MS=5000
# Routing strategy: hybrid | breaker | thompson | thompson_cost (see docs/ROUTING-LAB.md)
ROUTING_STRATEGY=hybrid
ROUTING_TS_HALF_LIFE_MS=60000
ROUTING_MIN_VIABLE_RATE=0.5
ROUTING_TS_PROBE_INTERVAL_MS=10000

# ---- Background jobs ----
POLL_INTERVAL_MS=15000
PENDING_POLL_AFTER_MS=30000
PAYMENT_EXPIRY_MS=1800000
RECONCILIATION_CRON=0 2 * * *
RECONCILIATION_TZ=Africa/Lagos

# ---- Rate limits (requests per minute) ----
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_MONEY_PER_MIN=300

# ---- Phase 1 teaching endpoint ----
# Enables POST /v1/withdrawals/naive (deliberately unsafe). Always off in production.
ENABLE_NAIVE_ENDPOINTS=true
# Artificial pause between "check balance" and "write" to make races easy to see.
RACE_WINDOW_MS=50

# ---- Public demo mode ----
# A shared, self-resetting sandbox: visitors click "Try the live demo" on the
# dashboard and get a temporary session with limited permissions and quotas.
# Requires ENABLE_NAIVE_ENDPOINTS=false. Resets ALL data every interval.
PUBLIC_DEMO=false
DEMO_SESSION_TTL_MS=7200000
DEMO_RESET_INTERVAL_MS=3600000
DEMO_PAYMENTS_PER_SESSION_PER_HOUR=200
DEMO_PAYMENTS_GLOBAL_PER_HOUR=3000
DEMO_ACTIONS_PER_MIN=60
DEMO_SESSIONS_PER_IP_PER_HOUR=20
# Set to 1 when running behind a hosting proxy so rate limits see real client IPs.
TRUST_PROXY=0
